{
    "name": "itspp/sistema-asistencias",
    "description": "API en PHP (api/) del sistema de asistencias a laboratorios: dependencias de desarrollo y pruebas",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Asistencias\\": "api/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Api\\": "tests/api/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
