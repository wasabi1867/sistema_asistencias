# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip
.firebase/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# API en PHP
# Datos reales de conexión: solo existen en el servidor y en cada máquina (ver api/config.ejemplo.php)
/api/config.local.php
# Dependencias y caché de las pruebas (composer install, vendor/bin/phpunit)
/vendor
/.phpunit.cache
# Respaldo de Firebase y respaldos de la base: datos personales
/respaldo-firebase*/
/importacion*.sql
*.sql.gz
/respaldo-*.sql
